{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-g1h2-i3j4k5l6m7n10",
    "name": "DSA Tracker - Progress Tracking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "APIs for tracking user completion of DSA problems."
  },
  "item": [
    {
      "name": "Progress",
      "item": [
        {
          "name": "Update Problem Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress/:problemId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "progress",
                ":problemId"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Get User Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "progress"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7200",
      "type": "string"
    }
  ]
}